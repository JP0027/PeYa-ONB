3. Reglas de formato Condicional (SLA)
Aplicar al intervalo AE3:AE1000. Las reglas aseguran que las métricas visuales solo resalten si la oportunidad sigue "En progreso".
   * Regla Roja (≥ 4 días):
=Y(ESPACIOS($O3)="En progreso"; VALOR(IZQUIERDA($AE3; ENCONTRAR(" "; $AE3)-1))>=4)
   * Regla Naranja (≥ 1 día):
=Y(ESPACIOS($O3)="En progreso"; VALOR(IZQUIERDA($AE3; ENCONTRAR(" "; $AE3)-1))>=1)
   * Regla Amarilla (≥ 4 horas):
=Y(ESPACIOS($O3)="En progreso"; (VALOR(IZQUIERDA($AE3; ENCONTRAR(" "; $AE3)-1))*24 + VALOR(EXTRAE($AE3; ENCONTRAR(", "; $AE3)+2; ENCONTRAR("h"; $AE3)-ENCONTRAR(", "; $AE3)-2))) >= 4)


4. Google Apps Script (Automatizaciones de flujo)
Este código debe ser pegado en Extensiones > Apps Script. Maneja la inyección dinámica de fórmulas en las celdas de Tiempo (POS y Catálogo) y las transiciones automáticas de "S/V" al avanzar estados.
/**
 * Triggers automáticos al editar la pestaña 'Onboarding_New'
 * (Valores inician en la fila 3)
 */


function onEdit(e) {
  if (!e || !e.range) return;
  const sheet = e.range.getSheet();
  const NOMBRE_HOJA = "Onboarding_New";


  if (sheet.getName() !== NOMBRE_HOJA) return;


  const row = e.range.getRow(), numRows = e.range.getNumRows();
  const col = e.range.getColumn(), numCols = e.range.getNumColumns();
  const lastCol = col + numCols - 1;


  // --- NUEVOS ÍNDICES DE COLUMNAS (Desplazamiento aplicado) ---
  const COL_ESTADO_CASO = 15;     // O
  const COL_ESTADO_ONB = 16;      // P
  const COL_ESTADO_TICKET = 17;   // Q (NUEVO)
  const COL_FECHA_CIERRE_OP = 20; // T (Antes S)
  const COL_FECHA_CIERRE_TICKET = 21; // U (NUEVO)
 
  const COL_INICIO_POS = 22, COL_PUSH_POS = 23, COL_RESP_POS = 24, COL_CHECK_POS = 25; // V a Y
  const COL_INICIO_CAT = 26, COL_PUSH_CAT = 27, COL_RESP_CAT = 28, COL_CHECK_CAT = 29; // Z a AC
 
  const COL_FREEZE_POS = 42; // AP (oculta, desplazada +2)
  const COL_FREEZE_CAT = 43; // AQ (oculta, desplazada +2)


  // Salida inmediata si la edición no toca ninguna columna relevante
  if (lastCol < COL_ESTADO_CASO || col > COL_CHECK_CAT) return;


  const primeraFila = Math.max(row, 3);
  const ultimaFila = row + numRows - 1;
  if (ultimaFila < 3) return;
  const filas = ultimaFila - primeraFila + 1;


  const editaEstadoCaso = col <= COL_ESTADO_CASO && lastCol >= COL_ESTADO_CASO;
  const editaEstadoOnb = col <= COL_ESTADO_ONB && lastCol >= COL_ESTADO_ONB;
  const editaEstadoTicket = col <= COL_ESTADO_TICKET && lastCol >= COL_ESTADO_TICKET;
  const editaInicioPOS = col <= COL_INICIO_POS && lastCol >= COL_INICIO_POS;
  const editaInicioCAT = col <= COL_INICIO_CAT && lastCol >= COL_INICIO_CAT;
  const editaRespPOS = col <= COL_RESP_POS && lastCol >= COL_RESP_POS;
  const editaRespCAT = col <= COL_RESP_CAT && lastCol >= COL_RESP_CAT;


  // Ampliamos el bloque a 15 columnas (De la O=15 a la AC=29)
  const rangoBloque = sheet.getRange(primeraFila, COL_ESTADO_CASO, filas, 15);
  const datos = rangoBloque.getValues();
  const rangoFreeze = sheet.getRange(primeraFila, COL_FREEZE_POS, filas, 2);
  const freeze = rangoFreeze.getValues();


  // --- ETAPAS DE ONBOARDING ---
  const estadosAmbos = [
    "Validación del Onboarding",
    "En proceso para pruebas",
    "Pedido de prueba realizado",
    "En proceso para pruebas (baja de integración)",
    "Pedido de prueba realizado (baja de integración)",
    "Solicitar creación de oportunidad Admin (Sin go)",
    "Sin configuraciones a nivel integración"
  ];
  const estadosSoloPOS = ["En proceso de verificación de catálogo"];


  for (let i = 0; i < filas; i++) {
    const d = datos[i];
    const estadoCaso = texto(d[0]);
    const estadoOnb = texto(d[1]);
    const estadoTicket = texto(d[2]); // Nuevo
   
    // Los índices del arreglo d se mueven +2 a partir del cierre OP
    let inicioPOS = d[7], pushPOS = d[8], respPOS = normalizarRespuesta(d[9]), checkPOS = d[10];
    let inicioCAT = d[11], pushCAT = d[12], respCAT = normalizarRespuesta(d[13]), checkCAT = d[14];
   
    let procesarRespPOS = editaRespPOS;
    let procesarRespCAT = editaRespCAT;


    // C. Fecha de cierre de OP (Índice 5 = Columna T)
    if (editaEstadoCaso) {
      d[5] = (estadoCaso === "" || estadoCaso === "Nuevo" || estadoCaso === "En progreso" || estadoCaso === "En progreso (sin oportunidad)" ) ? "" : new Date();
    }


    // NUEVO: Fecha de cierre de seguimiento (Índice 6 = Columna U)
    if (editaEstadoTicket) {
      const estadosAbiertos = ["Abierto", "Abierto (sin oportunidad)", "Transferido", ""];
      if (estadosAbiertos.includes(estadoTicket)) {
        d[6] = ""; // Borra la fecha
      } else {
        d[6] = new Date(); // Estampa fecha actual
      }
    }


    // D. Estado del onboarding -> S/V TOTAL solo si nunca inició el seguimiento
    if (editaEstadoOnb) {
      if (estadosAmbos.includes(estadoOnb)) {
        if (!tieneValor(inicioPOS)) {
          inicioPOS = "S/V"; pushPOS = "S/V"; respPOS = "S/V"; checkPOS = true; procesarRespPOS = true;
        }
        if (!tieneValor(inicioCAT)) {
          inicioCAT = "S/V"; pushCAT = "S/V"; respCAT = "S/V"; checkCAT = true; procesarRespCAT = true;
        }
      } else if (estadosSoloPOS.includes(estadoOnb)) {
        if (!tieneValor(inicioPOS)) {
          inicioPOS = "S/V"; pushPOS = "S/V"; respPOS = "S/V"; checkPOS = true; procesarRespPOS = true;
        }
      }
    }


    // A. Fecha de inicio POS API
    if (editaInicioPOS) {
      const f = parsearFecha(inicioPOS);
      if (f) inicioPOS = f;
    }


    // B. Fecha de inicio Catálogo
    if (editaInicioCAT) {
      const f = parsearFecha(inicioCAT);
      if (f) inicioCAT = f;
    }


    // --- REGLAS DE AVANCE LINEAL ---
   
    // POS API
    if (tieneValor(inicioPOS) && estadoOnb !== "") {
      const esperandoPOS = (estadoOnb === "Sin integración confirmada" || estadoOnb === "En proceso de seteo");
     
      if (!esperandoPOS) {
        if (respPOS !== "Si") { respPOS = "Si"; procesarRespPOS = true; }
      } else if (esperandoPOS && tieneValor(pushPOS)) {
        if (respPOS !== "No") { respPOS = "No"; procesarRespPOS = true; }
      }
    }


    // CATÁLOGO
    if (tieneValor(inicioCAT) && estadoOnb !== "") {
      const esperandoCAT = (estadoOnb === "En proceso de verificación de catálogo");
     
      if (estadosAmbos.includes(estadoOnb)) {
        if (respCAT !== "Si") { respCAT = "Si"; procesarRespCAT = true; }
      } else if (esperandoCAT && tieneValor(pushCAT)) {
        if (respCAT !== "No") { respCAT = "No"; procesarRespCAT = true; }
      }
    }


    // E. Procesar Respuesta POS API
    if (procesarRespPOS) {
      if (respPOS === "Si") {
        checkPOS = true;
        if (!esFecha(pushPOS)) pushPOS = "S/V";
        if (!esFecha(freeze[i][0])) freeze[i][0] = new Date();
      } else if (respPOS === "No") {
        checkPOS = false;
        if (!esFecha(pushPOS) && texto(pushPOS).toUpperCase() === "S/V") pushPOS = "";
        freeze[i][0] = "";
      } else if (respPOS === "S/V") {
        checkPOS = true;
        if (estaVacio(pushPOS)) pushPOS = "S/V";
        freeze[i][0] = "";
      }
    }


    // F. Procesar Respuesta Catálogo
    if (procesarRespCAT) {
      if (respCAT === "Si") {
        checkCAT = true;
        if (!esFecha(pushCAT)) pushCAT = "S/V";
        if (!esFecha(freeze[i][1])) freeze[i][1] = new Date();
      } else if (respCAT === "No") {
        checkCAT = false;
        if (!esFecha(pushCAT) && texto(pushCAT).toUpperCase() === "S/V") pushCAT = "";
        freeze[i][1] = "";
      } else if (respCAT === "S/V") {
        checkCAT = true;
        if (estaVacio(pushCAT)) pushCAT = "S/V";
        freeze[i][1] = "";
      }
    }


    d[7] = inicioPOS; d[8] = pushPOS; d[9] = normalizarRespuesta(respPOS); d[10] = checkPOS;
    d[11] = inicioCAT; d[12] = pushCAT; d[13] = normalizarRespuesta(respCAT); d[14] = checkCAT;
  }


  rangoBloque.setValues(datos);
  rangoFreeze.setValues(freeze);
}


// --- FUNCIONES AUXILIARES ---


function parsearFecha(val) {
  if (val instanceof Date && !isNaN(val.getTime())) return val;
  if (typeof val === "number") {
    return new Date(Math.round((val - 25569) * 86400 * 1000));
  }
  if (typeof val === "string") {
    const s = val.trim();
    if (s === "" || s.toUpperCase() === "S/V") return null;
    let d = new Date(s);
    if (!isNaN(d.getTime())) return d;
    const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?$/);
    if (m) {
      const dd = parseInt(m[1], 10), mm = parseInt(m[2], 10) - 1;
      let yyyy = parseInt(m[3], 10);
      if (yyyy < 100) yyyy += 2000;
      const hh = m[4] ? parseInt(m[4], 10) : 0, mi = m[5] ? parseInt(m[5], 10) : 0, ss = m[6] ? parseInt(m[6], 10) : 0;
      const d2 = new Date(yyyy, mm, dd, hh, mi, ss);
      if (!isNaN(d2.getTime())) return d2;
    }
    return null;
  }
  return null;
}


function esFecha(valor) {
  return valor instanceof Date && !isNaN(valor.getTime());
}


function estaVacio(valor) {
  return valor === "" || valor === null || typeof valor === "undefined";
}


function tieneValor(valor) {
  return !estaVacio(valor) && texto(valor).toUpperCase() !== "S/V";
}


function texto(valor) {
  return valor === null || typeof valor === "undefined" ? "" : String(valor).trim();
}


function normalizarRespuesta(valor) {
  const v = texto(valor).toLowerCase();
  if (v === "si") return "Si";
  if (v === "no") return "No";
  if (v === "s/v") return "S/V";
  return valor;
}






5. Consideraciones clave para el mantenimiento
      * Ausencia de MAP en Tiempos de Seguimiento (AF y AG): Para que el congelamiento de tiempo individual funcione con Apps Script, las columnas AF y AG NO deben contener funciones MAP en el encabezado. Si se usan, arrojarán errores de desbordamiento (#¡REF!).
      * Idioma de Funciones Híbridas: Para evitar el error Función desconocida (Ej: "#NAME?"), se utilizó .setFormulaLocal(). Esto permite que el script inyecte funciones escritas nativamente en español.
      * Protección Visual: Las columnas a partir de la AB ("Zona Automática") en adelante, se encuentran agrupadas y ocultas, se pueden mostrar con el icono de + de la parte arriba.
