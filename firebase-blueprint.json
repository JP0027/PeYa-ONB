{
  "entities": {
    "usuario": {
      "title": "Usuario",
      "description": "Usuario autorizado con rol y pestañas asignadas",
      "type": "object",
      "properties": {
        "correo": { "type": "string" },
        "nombre": { "type": "string" },
        "rol": { "type": "string" },
        "pestanas": { "type": "array", "items": { "type": "string" } },
        "actualizadoEn": { "type": "string" }
      },
      "required": ["correo", "rol"]
    }
  },
  "firestore": {
    "/usuarios_permitidos/{usuarioId}": {
      "schema": { "$ref": "#/entities/usuario" },
      "description": "Lista de usuarios autorizados de la plataforma"
    }
  }
}
